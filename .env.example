# Required for the first startup. Replace this value locally and never commit .env.
SBEANS_ADMIN_PASSWORD=replace-with-a-long-random-password
# Generic OpenAI-compatible visual provider. Set the API base URL through /v1; mode adds the final path.
VISION_API_URL=
VISION_API_KEY=
VISION_MODEL=
# Supported values: chat_completions or responses.
VISION_API_MODE=chat_completions
# Default sends Authorization: Bearer <key>. Use x-api-key with an empty prefix when required.
VISION_AUTH_HEADER=Authorization
VISION_AUTH_PREFIX=Bearer
# Legacy Gemini fallback when all VISION_* URL/key/model fields above are left empty.
GEMINI_API_KEY=replace-with-your-gemini-api-key
